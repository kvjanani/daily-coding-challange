  class Solution {
    public int subtractProductAndSum(int n) {
        int remainder = 0, product = 1, sum = 0;

        while (n > 0) {
            remainder = n % 10;
            product *= remainder;
            sum += remainder;
            n = n / 10;
        }

        return product - sum;
    }
}
2.1342
  class Solution {
    public int numberOfSteps(int num) {
        int count = 0;
        while (num > 0) {
            if (num % 2 == 0) {
                num /= 2;
            } else {
                num -= 1;
            }
            count++;
        }
        return count;
    }
}
