1. LeetCode 796 – Rotate String
  class Solution {
    public boolean rotateString(String s, String goal) {
        if (s.length() != goal.length()) {
            return false;
        }

        return (s + s).contains(goal);
    }
}
2. LeetCode 441 – Arranging Coins
  class Solution {
    public int arrangeCoins(int n) {
        int row = 1;

        while (n >= row) {
            n = n - row;
            row++;
        }

        return row - 1;
    }
}
