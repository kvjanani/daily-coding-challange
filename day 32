  class Solution {
    public int[] numberOfLines(int[] widths, String s) {
        int lines = 1;
        int pixels = 0;

        for (char c : s.toCharArray()) {
            int w = widths[c - 'a'];

            if (pixels + w > 100) {
                lines++;
                pixels = w;
            } else {
                pixels += w;
            }
        }

        return new int[]{lines, pixels};
    }
}
